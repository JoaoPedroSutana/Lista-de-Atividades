<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<GridPane xmlns="http://javafx.com/javafx/21"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="org.example.FormularioController"
          hgap="8"
          vgap="12"
          alignment="TOP_LEFT">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <columnConstraints>
        <ColumnConstraints minWidth="170" prefWidth="170"/>
        <ColumnConstraints minWidth="165" prefWidth="165"/>
    </columnConstraints>

    <Label text="Informe CPF:"
           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="cpfField"
               promptText="Digite o CPF"
               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Label text="Nome:"
           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="nomeField"
               promptText="Digite o nome"
               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Endereço:"
           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="enderecoField"
               promptText="Digite o endereço"
               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label text="Estado:"
           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <ComboBox fx:id="estadoCombo"
              promptText="Selecione o estado"
              maxWidth="Infinity"
              GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <Label text="Cargo:"
           GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <ComboBox fx:id="cargoCombo"
              promptText="Selecione o cargo"
              maxWidth="Infinity"
              GridPane.rowIndex="4" GridPane.columnIndex="1"/>

    <Button fx:id="imprimirButton"
            text="Imprimir Dados"
            GridPane.rowIndex="5"
            GridPane.columnIndex="0"
            GridPane.columnSpan="2"/>

</GridPane>